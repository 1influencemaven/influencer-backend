// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum IbpStatus {
  DRAFT
  PROCESSING
  ACTIVE
  FAILED
}

enum BrandDiscoveryStatus {
  PROCESSING
  COMPLETED
  FAILED
}

enum BrandCandidateStatus {
  UNDER_REVIEW
  APPROVED
  REJECTED
  POSTPONED
}

enum LeadDiscoveryStatus {
  PROCESSING
  COMPLETED
  FAILED
}

enum LeadStatus {
  UNDER_REVIEW
  APPROVED
  DISCARDED
  DUPLICATE
}

enum LeadEmailConfidence {
  VALID
  PROBABLE
  DOUBTFUL
  INVALID
  UNKNOWN
}

model User {
  id                 String              @id @default(uuid())
  name               String
  email              String              @unique
  password           String
  role               Role                @default(USER)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  refreshTokens                 RefreshToken[]
  ibpPromptTemplates            IbpPromptTemplate[]
  brandDiscoveryPromptTemplates BrandDiscoveryPromptTemplate[]
  leadDiscoveryPromptTemplates  LeadDiscoveryPromptTemplate[]
}

model RefreshToken {
  id                 String   @id @default(uuid())
  hashedRefreshToken String?
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt          DateTime
  createdAt          DateTime @default(now())

  @@index([userId])
}

model Influencer {
  id                String             @id @default(uuid())
  name              String
  instagram         String?
  tiktok            String?
  youtube           String?
  country           String?
  language          String?
  niche             String?
  subNiche          String?
  followers         Int?
  engagement        Decimal?           @db.Decimal(5, 2)
  email             String?
  mediaKitUrl       String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  idealBrandProfile  IdealBrandProfile?
  brandDiscoveryRuns BrandDiscoveryRun[]
  brandCandidates    BrandCandidate[]
  leadDiscoveryRuns  LeadDiscoveryRun[]
  leads              Lead[]

  @@index([country])
  @@index([niche])
  @@index([createdAt])
}

model IdealBrandProfile {
  id                 String     @id @default(uuid())
  influencerId       String     @unique
  influencer         Influencer @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  status             IbpStatus  @default(DRAFT)
  targetSectors      String[]
  excludedSectors    String[]
  brandSize          String[]
  markets            String[]
  collaborationTypes String[]
  summary            String     @default("")
  alertSignals       String[]
  desirableCriteria  String[]
  metadata           Json?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@index([status])
}

model IbpPromptTemplate {
  id           String   @id @default("default")
  instructions String
  updatedById  String?
  updatedBy    User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([updatedById])
}

model BrandDiscoveryPromptTemplate {
  id           String   @id @default("default")
  instructions String
  updatedById  String?
  updatedBy    User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([updatedById])
}

model LeadDiscoveryPromptTemplate {
  id           String   @id @default("default")
  instructions String
  updatedById  String?
  updatedBy    User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([updatedById])
}

model BrandDiscoveryRun {
  id            String                @id @default(uuid())
  influencerId  String
  influencer    Influencer            @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  status        BrandDiscoveryStatus  @default(PROCESSING)
  source        String
  limit         Int                   @default(20)
  ibpSnapshot   Json
  errorMessage  String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  candidates    BrandCandidate[]

  @@index([influencerId])
  @@index([status])
  @@index([createdAt])
}

model BrandCandidate {
  id             String                @id @default(uuid())
  influencerId   String
  influencer     Influencer            @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  discoveryRunId String
  discoveryRun   BrandDiscoveryRun     @relation(fields: [discoveryRunId], references: [id], onDelete: Cascade)
  name           String
  website        String
  domain         String
  sector         String?
  market         String?
  brandSize      String?
  score          Float?
  fitReason      String?
  source         String
  evidenceUrls   String[]
  status         BrandCandidateStatus  @default(UNDER_REVIEW)
  metadata       Json?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  leadDiscoveryRuns LeadDiscoveryRun[]
  leads             Lead[]

  @@index([influencerId])
  @@index([discoveryRunId])
  @@index([status])
  @@index([domain])
  @@index([createdAt])
}

model LeadDiscoveryRun {
  id               String              @id @default(uuid())
  brandCandidateId String
  brandCandidate   BrandCandidate      @relation(fields: [brandCandidateId], references: [id], onDelete: Cascade)
  influencerId     String
  influencer       Influencer          @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  status           LeadDiscoveryStatus @default(PROCESSING)
  providerId       String
  providerOptions  Json
  limit            Int                 @default(10)
  errorMessage     String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  leads            Lead[]

  @@index([brandCandidateId])
  @@index([influencerId])
  @@index([status])
  @@index([createdAt])
}

model Lead {
  id               String              @id @default(uuid())
  brandCandidateId String
  brandCandidate   BrandCandidate      @relation(fields: [brandCandidateId], references: [id], onDelete: Cascade)
  influencerId     String
  influencer       Influencer          @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  runId            String
  run              LeadDiscoveryRun    @relation(fields: [runId], references: [id], onDelete: Cascade)
  contactName      String
  title            String?
  email            String
  emailConfidence  LeadEmailConfidence @default(UNKNOWN)
  isGeneric        Boolean             @default(false)
  profileUrl       String?
  providerId       String
  sourceOptionId   String?
  fitReason        String?
  source           String
  status           LeadStatus          @default(UNDER_REVIEW)
  metadata         Json?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([brandCandidateId])
  @@index([influencerId])
  @@index([runId])
  @@index([status])
  @@index([email])
  @@index([createdAt])
}
