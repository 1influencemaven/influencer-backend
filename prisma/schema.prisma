// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum ProfileStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id            String         @id @default(uuid())
  name          String
  email         String         @unique
  password      String
  role          Role           @default(USER)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  refreshTokens RefreshToken[]
}

model RefreshToken {
  id                 String   @id @default(uuid())
  hashedRefreshToken String?
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt          DateTime
  createdAt          DateTime @default(now())

  @@index([userId])
}

model Influencer {
  id                String        @id @default(uuid())
  name              String
  instagram         String?
  tiktok            String?
  youtube           String?
  country           String?
  language          String?
  niche             String?
  subNiche          String?
  followers         Int?
  engagement        Decimal?      @db.Decimal(5, 2)
  email             String?
  mediaKitUrl       String?
  profileStatus     ProfileStatus @default(PENDING)
  commercialProfile Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([profileStatus])
  @@index([country])
  @@index([niche])
  @@index([createdAt])
}
