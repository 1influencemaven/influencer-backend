// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum IbpStatus {
  DRAFT
  PROCESSING
  ACTIVE
  FAILED
}

model User {
  id                 String              @id @default(uuid())
  name               String
  email              String              @unique
  password           String
  role               Role                @default(USER)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  refreshTokens      RefreshToken[]
  ibpPromptTemplates IbpPromptTemplate[]
}

model RefreshToken {
  id                 String   @id @default(uuid())
  hashedRefreshToken String?
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt          DateTime
  createdAt          DateTime @default(now())

  @@index([userId])
}

model Influencer {
  id                String             @id @default(uuid())
  name              String
  instagram         String?
  tiktok            String?
  youtube           String?
  country           String?
  language          String?
  niche             String?
  subNiche          String?
  followers         Int?
  engagement        Decimal?           @db.Decimal(5, 2)
  email             String?
  mediaKitUrl       String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  idealBrandProfile IdealBrandProfile?

  @@index([country])
  @@index([niche])
  @@index([createdAt])
}

model IdealBrandProfile {
  id                 String     @id @default(uuid())
  influencerId       String     @unique
  influencer         Influencer @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  status             IbpStatus  @default(DRAFT)
  targetSectors      String[]
  excludedSectors    String[]
  brandSize          String[]
  markets            String[]
  collaborationTypes String[]
  summary            String     @default("")
  alertSignals       String[]
  desirableCriteria  String[]
  metadata           Json?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@index([status])
}

model IbpPromptTemplate {
  id           String   @id @default("default")
  instructions String
  updatedById  String?
  updatedBy    User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([updatedById])
}
