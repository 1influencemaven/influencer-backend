// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum IbpStatus {
  DRAFT
  PROCESSING
  ACTIVE
  FAILED
}

enum BrandDiscoveryStatus {
  PROCESSING
  COMPLETED
  FAILED
}

enum BrandCandidateStatus {
  UNDER_REVIEW
  APPROVED
  REJECTED
  POSTPONED
}

/// Nest evidence classifier outcome for Brand Discovery (AI-004.5.5).
/// Orthogonal to BrandCandidateStatus (review workflow).
/// Historical rows and Legacy creates use NOT_ASSESSED — never inferred from evidenceUrls.
enum EvidenceStatus {
  VERIFIED
  UNVERIFIED
  NOT_ASSESSED
}

enum LeadDiscoveryStatus {
  PROCESSING
  COMPLETED
  FAILED
}

/// Operational status for Instagram research BullMQ runs (Talent Manager).
enum InstagramResearchStatus {
  PROCESSING
  COMPLETED
  FAILED
}

/// Username lookup (create form) vs research of an existing Influencer.
enum InstagramResearchMode {
  USERNAME
  INFLUENCER
}

enum LeadStatus {
  UNDER_REVIEW
  APPROVED
  DISCARDED
  DUPLICATE
}

enum LeadEmailConfidence {
  VALID
  PROBABLE
  DOUBTFUL
  INVALID
  UNKNOWN
}

enum ContactChannelType {
  LINKEDIN
  EMAIL
  WEBSITE
}

enum ContactChannelStatus {
  ACTIVE
  INVALID
}

enum ContactChannelSource {
  LINKEDIN_SCRAPER
  PUBLIC_WEB
  MANUAL
  LEGACY_MIGRATION
  BRAND_WEBSITE
  /// Saleshandy Lead Finder / enrichment (provider-verified work email).
  SALESHANDY
}

/// Commercial value for outreach prioritization (ADR-0016).
/// Orthogonal to isGeneric (technical company/role inbox flag).
enum CommercialRelevance {
  HIGH
  NEUTRAL
  LOW
  UNKNOWN
}

/// Calendar quarter assignment for a talent (Talent Manager).
enum InfluencerQuarter {
  Q1
  Q2
  Q3
  Q4
}

/// Provenance of a talent profile field value (Talent Manager metadata).
enum InfluencerDataOrigin {
  MANUAL
  EXTERNAL
  LEGACY
}

/// Track 2C — agency taxonomy (identity-level; evidence-backed classification later).
enum AgencyType {
  INFLUENCER_MARKETING_AGENCY
  TALENT_REPRESENTATION
  MARKETPLACE
  GENERAL_MARKETING
  DIRECTORY
  OTHER
}

/// Track 2C — relevance of an Agency to a specific Influencer (association-level).
enum AgencyRelevanceStatus {
  UNDER_REVIEW
  RELEVANT
  NOT_RELEVANT
  DISCARDED
}

/// Track 2C.4 — Agency Contact Research: mailbox vs evidenced person at an Agency.
enum AgencyContactKind {
  MAILBOX
  PERSON
}

model User {
  id                            String                         @id @default(uuid())
  name                          String
  email                         String                         @unique
  password                      String
  role                          Role                           @default(USER)
  createdAt                     DateTime                       @default(now())
  updatedAt                     DateTime                       @updatedAt
  refreshTokens                 RefreshToken[]
  ibpPromptTemplates            IbpPromptTemplate[]
  brandDiscoveryPromptTemplates BrandDiscoveryPromptTemplate[]
  leadDiscoveryPromptTemplates  LeadDiscoveryPromptTemplate[]
  /// Talents where this user is the assigned manager (Talent Manager).
  managedInfluencers            Influencer[]                   @relation("InfluencerManager")
  emailAccountJobs              EmailAccountJob[]              @relation("EmailAccountJobInitiator")
  customFieldSyncRuns           CustomFieldSyncRun[]           @relation("CustomFieldSyncInitiator")
  emailTemplatesCreated         EmailTemplate[]                @relation("EmailTemplateCreator")
  emailTemplatesUpdated         EmailTemplate[]                @relation("EmailTemplateUpdater")
  prospectsCreated              Prospect[]                     @relation("ProspectCreator")
  prospectSyncJobs              ProspectSyncJob[]              @relation("ProspectSyncJobInitiator")
}

model RefreshToken {
  id                 String   @id @default(uuid())
  hashedRefreshToken String?
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt          DateTime
  createdAt          DateTime @default(now())

  @@index([userId])
}

model Influencer {
  id                        String                        @id @default(uuid())
  name                      String
  instagram                 String?
  /// Normalized Instagram handle for dedupe (Talent Manager). Independent of raw `instagram`.
  instagramNormalized       String?                       @unique
  tiktok                    String?
  youtube                   String?
  country                   String?
  language                  String?
  niche                     String?
  subNiche                  String?
  /// Multi-value niches (Talent Manager PASO 1). Legacy `niche` / `subNiche` retained.
  niches                    String[]                      @default([])
  followers                 Int?
  engagement                Decimal?                      @db.Decimal(5, 2)
  email                     String?
  /// Outbound / send-from email (Talent Manager PASO 1). Independent of legacy `email`.
  outgoingEmail             String?
  mediaKitUrl               String?
  /// Snapshot of Instagram username research at create (for Mastra). Null if created without lookup.
  /// Does not replace first-class columns (`followers`, `email`); hashtags are not niches.
  instagramResearchEvidence Json?
  managerId                 String?
  manager                   User?                         @relation("InfluencerManager", fields: [managerId], references: [id], onDelete: SetNull)
  createdAt                 DateTime                      @default(now())
  updatedAt                 DateTime                      @updatedAt
  idealBrandProfile         IdealBrandProfile?
  brandDiscoveryRuns        BrandDiscoveryRun[]
  brandCandidates           BrandCandidate[]
  leadDiscoveryRuns         LeadDiscoveryRun[]
  leads                     Lead[]
  influencerAgencies        InfluencerAgency[]
  quarterAssignments        InfluencerQuarterAssignment[]
  fieldProvenances          InfluencerFieldProvenance[]
  instagramResearchRuns     InstagramResearchRun[]
  emailTemplates            EmailTemplate[]
  prospects                 Prospect[]
  prospectSyncJobs          ProspectSyncJob[]

  @@index([country])
  @@index([niche])
  @@index([createdAt])
  @@index([managerId])
}

/// Durable job status for Instagram Bright Data research (async via BullMQ).
/// Operational only — username lookup still does not write Influencer until create.
model InstagramResearchRun {
  id               String                  @id @default(uuid())
  status           InstagramResearchStatus @default(PROCESSING)
  mode             InstagramResearchMode
  /// Raw username input (USERNAME mode).
  username         String?
  handleNormalized String?
  influencerId     String?
  influencer       Influencer?             @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  /// Success payload (username lookup or by-id research response).
  result           Json?
  errorCode        String?
  errorMessage     String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@index([status])
  @@index([mode])
  @@index([handleNormalized])
  @@index([influencerId])
  @@index([createdAt])
}

/// Historical quarter assignments for a talent. Multiple years/quarters allowed; never overwrite prior rows.
model InfluencerQuarterAssignment {
  id           String            @id @default(uuid())
  influencerId String
  influencer   Influencer        @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  quarter      InfluencerQuarter
  year         Int
  assignedAt   DateTime          @default(now())

  @@unique([influencerId, year, quarter])
  @@index([year])
}

/// Technical metadata: origin of a stored talent field value (not a functional form field).
model InfluencerFieldProvenance {
  id           String               @id @default(uuid())
  influencerId String
  influencer   Influencer           @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  fieldKey     String
  origin       InfluencerDataOrigin
  source       String?
  fetchedAt    DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@unique([influencerId, fieldKey])
}

model IdealBrandProfile {
  id                 String     @id @default(uuid())
  influencerId       String     @unique
  influencer         Influencer @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  status             IbpStatus  @default(DRAFT)
  targetSectors      String[]
  excludedSectors    String[]
  brandSize          String[]
  markets            String[]
  collaborationTypes String[]
  summary            String     @default("")
  alertSignals       String[]
  desirableCriteria  String[]
  metadata           Json?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@index([status])
}

model IbpPromptTemplate {
  id           String   @id @default("default")
  instructions String
  updatedById  String?
  updatedBy    User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([updatedById])
}

model BrandDiscoveryPromptTemplate {
  id           String   @id @default("default")
  instructions String
  updatedById  String?
  updatedBy    User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([updatedById])
}

model LeadDiscoveryPromptTemplate {
  id           String   @id @default("default")
  instructions String
  updatedById  String?
  updatedBy    User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([updatedById])
}

model BrandDiscoveryRun {
  id             String               @id @default(uuid())
  influencerId   String
  influencer     Influencer           @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  status         BrandDiscoveryStatus @default(PROCESSING)
  source         String
  limit          Int                  @default(20)
  ibpSnapshot    Json
  /// Search strategy audit: strategy, queries used, counts, fallback. Null on historical runs.
  searchMetadata Json?
  errorMessage   String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  candidates     BrandCandidate[]

  @@index([influencerId])
  @@index([status])
  @@index([createdAt])
}

model BrandCandidate {
  id                    String                 @id @default(uuid())
  influencerId          String
  influencer            Influencer             @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  discoveryRunId        String
  discoveryRun          BrandDiscoveryRun      @relation(fields: [discoveryRunId], references: [id], onDelete: Cascade)
  name                  String
  website               String
  domain                String
  sector                String?
  market                String?
  brandSize             String?
  score                 Float?
  fitReason             String?
  source                String
  evidenceUrls          String[]
  /// Nest-classified evidence state (AI-004.5.5). Default NOT_ASSESSED for Legacy / historical.
  evidenceStatus        EvidenceStatus         @default(NOT_ASSESSED)
  status                BrandCandidateStatus   @default(UNDER_REVIEW)
  metadata              Json?
  /// Lead selected for future outreach (ADR-0011). Orthogonal to Lead.status.
  selectedLeadId        String?                @unique
  selectedLead          Lead?                  @relation("BrandCandidateSelectedLead", fields: [selectedLeadId], references: [id], onDelete: SetNull)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  leadDiscoveryRuns     LeadDiscoveryRun[]
  leads                 Lead[]                 @relation("BrandCandidateLeads")
  brandBusinessContacts BrandBusinessContact[]
  prospects             Prospect[]

  @@index([influencerId])
  @@index([discoveryRunId])
  @@index([status])
  @@index([domain])
  @@index([influencerId, domain])
  @@index([createdAt])
}

model LeadDiscoveryRun {
  id               String              @id @default(uuid())
  brandCandidateId String
  brandCandidate   BrandCandidate      @relation(fields: [brandCandidateId], references: [id], onDelete: Cascade)
  influencerId     String
  influencer       Influencer          @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  status           LeadDiscoveryStatus @default(PROCESSING)
  providerId       String
  providerOptions  Json
  limit            Int                 @default(10)
  /// Contact Discovery audit (ADR-0017). Null on historical / FAILED runs.
  searchMetadata   Json?
  errorMessage     String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  leads            Lead[]

  @@index([brandCandidateId])
  @@index([influencerId])
  @@index([status])
  @@index([createdAt])
}

model Lead {
  id                       String              @id @default(uuid())
  brandCandidateId         String
  brandCandidate           BrandCandidate      @relation("BrandCandidateLeads", fields: [brandCandidateId], references: [id], onDelete: Cascade)
  influencerId             String
  influencer               Influencer          @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  runId                    String
  run                      LeadDiscoveryRun    @relation(fields: [runId], references: [id], onDelete: Cascade)
  contactName              String
  title                    String?
  /// Legacy mirror — future source of truth: ContactChannel (EMAIL). Nullable since ADR-0014.
  email                    String?
  emailConfidence          LeadEmailConfidence @default(UNKNOWN)
  isGeneric                Boolean             @default(false)
  /// Legacy mirror — future source of truth: ContactChannel (LINKEDIN).
  profileUrl               String?
  providerId               String
  sourceOptionId           String?
  fitReason                String?
  source                   String
  status                   LeadStatus          @default(UNDER_REVIEW)
  metadata                 Json?
  /// Inverse of BrandCandidate.selectedLead (ADR-0011). At most one brand points here.
  selectedByBrandCandidate BrandCandidate?     @relation("BrandCandidateSelectedLead")
  contactChannels          ContactChannel[]
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt
  prospects                Prospect[]

  @@index([brandCandidateId])
  @@index([influencerId])
  @@index([runId])
  @@index([status])
  @@index([email])
  @@index([createdAt])
}

model ContactChannel {
  id                  String               @id @default(uuid())
  leadId              String
  lead                Lead                 @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type                ContactChannelType
  value               String
  valueNormalized     String
  status              ContactChannelStatus @default(ACTIVE)
  source              ContactChannelSource
  sourceUrl           String?
  isGeneric           Boolean?
  /// Business priority; independent of isGeneric. Default UNKNOWN for historical rows (ADR-0016).
  commercialRelevance CommercialRelevance  @default(UNKNOWN)
  metadata            Json?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@unique([leadId, type, valueNormalized])
  @@index([leadId])
  @@index([type])
}

/// Company-level commercial contact without an identified person (Contact Discovery 2A).
/// Must NOT be modeled as a Lead (Lead = person only). See ADR-0016.
model BrandBusinessContact {
  id                  String               @id @default(uuid())
  brandCandidateId    String
  brandCandidate      BrandCandidate       @relation(fields: [brandCandidateId], references: [id], onDelete: Cascade)
  email               String
  emailNormalized     String
  /// Optional display label (e.g. "Partnerships") — not a person name.
  label               String?
  isGeneric           Boolean              @default(true)
  commercialRelevance CommercialRelevance  @default(UNKNOWN)
  source              ContactChannelSource
  sourceUrl           String?
  metadata            Json?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  prospects           Prospect[]

  @@unique([brandCandidateId, emailNormalized])
  @@index([brandCandidateId])
  @@index([emailNormalized])
}

/// Track 2C — unique agency identity (not a BrandCandidate).
/// Dedup key: `domain` (normalized host, no www). `normalizedName` aids search only.
model Agency {
  id                 String             @id @default(uuid())
  name               String
  /// Lowercase collapsed name for search / soft matching (not unique).
  normalizedName     String
  website            String?
  /// Unique normalized host (lowercase, no leading www).
  domain             String             @unique
  country            String?
  description        String?
  agencyType         AgencyType         @default(OTHER)
  /// Extensible identity metadata (future enrichment); not association evidence.
  metadata           Json?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  influencerAgencies InfluencerAgency[]
  contacts           AgencyContact[]
  prospects          Prospect[]

  @@index([normalizedName])
  @@index([agencyType])
  @@index([createdAt])
}

/// Track 2C — discovery / relevance of an Agency for one Influencer.
model InfluencerAgency {
  id                   String                @id @default(uuid())
  influencerId         String
  influencer           Influencer            @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  agencyId             String
  agency               Agency                @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  relevanceStatus      AgencyRelevanceStatus @default(UNDER_REVIEW)
  relevanceExplanation String?
  niches               String[]              @default([])
  markets              String[]              @default([])
  evidenceUrls         String[]              @default([])
  /// Per-discovery audit (queries, SERP diagnostics, classifier notes). Null until 2C runs.
  searchMetadata       Json?
  discoveredAt         DateTime              @default(now())
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@unique([influencerId, agencyId])
  @@index([influencerId])
  @@index([agencyId])
  @@index([relevanceStatus])
  @@index([discoveredAt])
}

/// Track 2C.4 — commercial contact at an Agency (mailbox or evidenced person).
/// Not BrandBusinessContact / Lead / ContactChannel. Provenance (RF-01) lives in metadata.
model AgencyContact {
  id                  String              @id @default(uuid())
  agencyId            String
  agency              Agency              @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  email               String
  emailNormalized     String
  /// Optional role/inbox label (e.g. "Partnerships") — not a person name.
  label               String?
  /// Person display name when contactKind = PERSON and RF-01 attribution holds.
  displayName         String?
  title               String?
  contactKind         AgencyContactKind   @default(MAILBOX)
  isGeneric           Boolean             @default(true)
  /// Outreach priority (ADR-0016 / RF-02 mapping). Orthogonal to AgencyRelevanceStatus.
  commercialRelevance CommercialRelevance @default(UNKNOWN)
  /// Evidences, discoveryStatus, attributionStatus, verificationStatus (UNVERIFIED),
  /// outreachRole, sourceUrl, sourceKind — Nest-owned; never invent VERIFIED.
  metadata            Json?
  discoveredAt        DateTime            @default(now())
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  prospects           Prospect[]

  @@unique([agencyId, emailNormalized])
  @@index([agencyId])
  @@index([emailNormalized])
  @@index([commercialRelevance])
  @@index([contactKind])
  @@index([discoveredAt])
}

/// Review/health state of a brand in the shared knowledge base (BKB).
enum BrandKnowledgeStatus {
  ACTIVE
  STALE
  BLOCKED
}

/// Shared (cross-manager) memory of a brand, unique per normalized domain.
/// Fed from BrandCandidate persistence and review decisions; never owned by one influencer.
model Brand {
  id             String               @id @default(uuid())
  domain         String               @unique
  name           String
  website        String
  sectors        String[]             @default([])
  markets        String[]             @default([])
  sizeTag        String?
  /// Latest verified evidence URLs (bounded by the service).
  evidenceUrls   String[]             @default([])
  status         BrandKnowledgeStatus @default(ACTIVE)
  /// Summary of the last Contact Discovery outcome (counts/date), not contact PII.
  contactYield   Json?
  firstSeenAt    DateTime             @default(now())
  lastSeenAt     DateTime             @default(now())
  lastVerifiedAt DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  affinities     BrandNicheAffinity[]

  @@index([status, lastVerifiedAt])
  @@index([lastSeenAt])
}

/// Brand x niche signal: how often a brand was surfaced for a niche and how reviewers decided.
/// Counters are aggregate only (no per-manager decisions are exposed).
model BrandNicheAffinity {
  id                 String    @id @default(uuid())
  brandId            String
  brand              Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  /// Canonical niche slug (taxonomy group key or a concrete term slug).
  nicheKey           String
  surfacedCount      Int       @default(0)
  approvedCount      Int       @default(0)
  rejectedCount      Int       @default(0)
  postponedCount     Int       @default(0)
  scoreSum           Float     @default(0)
  scoredCount        Int       @default(0)
  /// scoreSum / scoredCount, maintained atomically in SQL.
  avgScore           Float     @default(0)
  lastScore          Float?
  collaborationTypes String[]  @default([])
  lastSurfacedAt     DateTime  @default(now())
  lastDecisionAt     DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([brandId, nicheKey])
  @@index([nicheKey, avgScore(sort: Desc)])
  @@index([nicheKey, approvedCount])
  @@index([nicheKey, lastSurfacedAt])
  @@index([brandId])
}

/// Saleshandy async email-account process (HU-EA-002/003/004).
enum EmailAccountJobType {
  CONNECT
  RECONNECT
}

enum EmailAccountJobStatus {
  PROCESSING
  COMPLETED
  FAILED
}

/// Durable tracking of a Saleshandy connect/reconnect request (requestId).
/// Never stores SMTP/IMAP passwords: only sender emails or account ids.
model EmailAccountJob {
  id            String                @id @default(uuid())
  /// Saleshandy requestId for /v1/email-accounts/connect/status/{requestId}.
  requestId     String                @unique
  type          EmailAccountJobType
  status        EmailAccountJobStatus @default(PROCESSING)
  /// Number of accounts submitted.
  accountCount  Int
  /// Sender emails (CONNECT) or Saleshandy account ids (RECONNECT). No secrets.
  targets       String[]              @default([])
  /// CSV report with per-account import details (set when completed).
  reportUrl     String?
  errorMessage  String?
  initiatedById String?
  initiatedBy   User?                 @relation("EmailAccountJobInitiator", fields: [initiatedById], references: [id], onDelete: SetNull)
  lastCheckedAt DateTime?
  completedAt   DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([status])
  @@index([createdAt])
}

/// Saleshandy prospect field data types (HU-FLD-001 CA-02).
enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  LONG_TEXT
  DROPDOWN
  CURRENCY
}

/// Saleshandy built-in field vs user-created field (HU-FLD-001 CA-03).
enum CustomFieldOrigin {
  SYSTEM
  CUSTOM
}

/// Why a field is inactive: disabled by an admin, or gone from Saleshandy.
enum CustomFieldDisabledReason {
  MANUAL
  REMOVED_IN_SALESHANDY
}

enum CustomFieldSyncStatus {
  COMPLETED
  FAILED
}

enum CustomFieldSyncTrigger {
  MANUAL
  BOOTSTRAP
  AFTER_WRITE
}

/// Local catalog of Saleshandy prospect fields / template variables
/// (HU-FLD-001..005). Influencer profile data never lives here (FLD-005 CA-05).
/// Saleshandy's GET /fields does not return `fallbackText` nor `metadata`, so
/// this table is the only source of truth for them.
model CustomField {
  id                 String                     @id @default(uuid())
  /// Stable identifier for mappings / template variables. Immutable.
  key                String                     @unique
  label              String
  fieldType          CustomFieldType
  origin             CustomFieldOrigin          @default(CUSTOM)
  fallbackText       String?
  /// Saleshandy public field id (unique when present).
  saleshandyFieldId  String?                    @unique
  /// Saleshandy `mappingDefaultField` for system fields (e.g. `firstName`).
  systemMapping      String?
  /// `{ options: string[] }` (DROPDOWN) or `{ currencyCode: string }` (CURRENCY).
  metadata           Json?
  /// Field tags (own namespace, not Prospect Tags).
  tags               String[]                   @default([])
  isActive           Boolean                    @default(true)
  disabledReason     CustomFieldDisabledReason?
  lastSyncedAt       DateTime?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  templateReferences EmailTemplateField[]
  prospectValues     ProspectFieldValue[]

  @@index([origin, isActive])
  @@index([fieldType])
}

/// Audit of Saleshandy field synchronizations (HU-FLD-005 CA-04).
model CustomFieldSyncRun {
  id               String                 @id @default(uuid())
  status           CustomFieldSyncStatus
  trigger          CustomFieldSyncTrigger
  remoteCount      Int                    @default(0)
  createdCount     Int                    @default(0)
  updatedCount     Int                    @default(0)
  unchangedCount   Int                    @default(0)
  deactivatedCount Int                    @default(0)
  errorCode        String?
  errorMessage     String?
  initiatedById    String?
  initiatedBy      User?                  @relation("CustomFieldSyncInitiator", fields: [initiatedById], references: [id], onDelete: SetNull)
  startedAt        DateTime               @default(now())
  completedAt      DateTime?

  @@index([startedAt])
}

// ============================================================
// SALESHANDY - TEMPLATES (HU-TPL-001, HU-TPL-002)
// ============================================================

enum EmailTemplateStatus {
  ACTIVE
  ARCHIVED
}

/// Reusable email template owned by a talent (HU-TPL-001). Deleted with the
/// talent (product decision 2026-11-26). Variables are stored as stable keys
/// (`{{firstName}}`, `{{influencer.name}}`) and exported to Saleshandy labels.
model EmailTemplate {
  id                  String               @id @default(uuid())
  influencerId        String
  influencer          Influencer           @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  name                String
  subject             String
  preHeader           String?
  /// Sanitized HTML; variables as `<span data-variable-key="...">{{key}}</span>`.
  bodyHtml            String
  /// Plain-text version generated on save.
  bodyText            String
  /// `influencer.*` variables used (CustomField ones live in EmailTemplateField).
  influencerVariables String[]             @default([])
  /// Number of variable issues found on the last save (0 = clean).
  validationIssues    Int                  @default(0)
  status              EmailTemplateStatus  @default(ACTIVE)
  createdById         String?
  createdBy           User?                @relation("EmailTemplateCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById         String?
  updatedBy           User?                @relation("EmailTemplateUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  fieldReferences     EmailTemplateField[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([influencerId, status])
  @@index([updatedAt])
}

/// EmailTemplate ↔ CustomField dependency (HU-TPL-002). CustomField is never
/// hard-deleted, so references survive when a field is disabled (CA-04).
model EmailTemplateField {
  id            String        @id @default(uuid())
  templateId    String
  template      EmailTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  customFieldId String
  customField   CustomField   @relation(fields: [customFieldId], references: [id], onDelete: Restrict)
  /// CustomField.key at save time.
  variableKey   String
  /// Where it appears: subject | preHeader | body.
  locations     String[]      @default([])
  createdAt     DateTime      @default(now())

  @@unique([templateId, customFieldId])
  @@index([customFieldId])
}

// ============================================================
// PROSPECTS (prerequisite of HU-TPL-010/011)
// ============================================================

enum ProspectSource {
  LEAD
  BRAND_CONTACT
  AGENCY_CONTACT
  CSV
  MANUAL
  SALESHANDY
}

enum ProspectContactKind {
  PERSON
  MAILBOX
}

enum ProspectStatus {
  ACTIVE
  ARCHIVED
}

enum ProspectSyncStatus {
  LOCAL_ONLY
  SYNCING
  SYNCED
  SYNC_FAILED
}

enum ProspectSyncJobType {
  CSV_IMPORT
  SALESHANDY_PUSH
}

enum ProspectSyncJobStatus {
  PROCESSING
  COMPLETED
  FAILED
}

/// Contact approved for outreach for one talent: created when a user approves
/// a discovered contact (lead, brand email, agency contact) or imports a CSV.
/// System fields live in columns; ProspectFieldValue holds custom fields only.
/// Never invent names (RF-01): mailboxes keep firstName null.
model Prospect {
  id                     String                @id @default(uuid())
  influencerId           String
  influencer             Influencer            @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  email                  String
  /// trim + lowercase; unique per talent.
  emailNormalized        String
  firstName              String?
  lastName               String?
  jobTitle               String?
  company                String?
  companyDomain          String?
  website                String?
  linkedInUrl            String?
  country                String?
  phoneNumber            String?
  contactKind            ProspectContactKind   @default(PERSON)
  isGeneric              Boolean               @default(false)
  /// Mailbox label (e.g. "Partnerships"); never used as firstName.
  mailboxLabel           String?
  commercialRelevance    CommercialRelevance   @default(UNKNOWN)
  source                 ProspectSource
  brandCandidateId       String?
  brandCandidate         BrandCandidate?       @relation(fields: [brandCandidateId], references: [id], onDelete: SetNull)
  brandBusinessContactId String?
  brandBusinessContact   BrandBusinessContact? @relation(fields: [brandBusinessContactId], references: [id], onDelete: SetNull)
  leadId                 String?
  lead                   Lead?                 @relation(fields: [leadId], references: [id], onDelete: SetNull)
  agencyId               String?
  agency                 Agency?               @relation(fields: [agencyId], references: [id], onDelete: SetNull)
  agencyContactId        String?
  agencyContact          AgencyContact?        @relation(fields: [agencyContactId], references: [id], onDelete: SetNull)
  /// Prospect tags (own namespace).
  tags                   String[]              @default([])
  status                 ProspectStatus        @default(ACTIVE)
  saleshandyProspectId   String?
  syncStatus             ProspectSyncStatus    @default(LOCAL_ONLY)
  lastSyncedAt           DateTime?
  lastSyncError          String?
  createdById            String?
  createdBy              User?                 @relation("ProspectCreator", fields: [createdById], references: [id], onDelete: SetNull)
  fieldValues            ProspectFieldValue[]
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  @@unique([influencerId, emailNormalized])
  @@index([influencerId, status])
  @@index([source])
  @@index([brandCandidateId])
  @@index([leadId])
  @@index([brandBusinessContactId])
  @@index([agencyContactId])
}

/// Value of a custom field (or a system field without a column) for a prospect.
model ProspectFieldValue {
  id            String      @id @default(uuid())
  prospectId    String
  prospect      Prospect    @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  customFieldId String
  customField   CustomField @relation(fields: [customFieldId], references: [id], onDelete: Restrict)
  value         String
  updatedAt     DateTime    @updatedAt

  @@unique([prospectId, customFieldId])
  @@index([customFieldId])
}

/// Durable tracking of CSV imports and pushes to Saleshandy.
model ProspectSyncJob {
  id             String                @id @default(uuid())
  influencerId   String?
  influencer     Influencer?           @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  type           ProspectSyncJobType
  status         ProspectSyncJobStatus @default(PROCESSING)
  /// Saleshandy requestId (pushes only).
  requestId      String?               @unique
  conflictAction String?
  totalCount     Int                   @default(0)
  createdCount   Int                   @default(0)
  updatedCount   Int                   @default(0)
  skippedCount   Int                   @default(0)
  failedCount    Int                   @default(0)
  /// First failing rows: [{ row, email, reason }] (bounded).
  errorSummary   Json?
  reportUrl      String?
  errorMessage   String?
  initiatedById  String?
  initiatedBy    User?                 @relation("ProspectSyncJobInitiator", fields: [initiatedById], references: [id], onDelete: SetNull)
  lastCheckedAt  DateTime?
  completedAt    DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([influencerId, createdAt])
  @@index([status])
}
