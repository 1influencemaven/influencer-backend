PORT=

FRONTEND_URL=

DATABASE_URL=

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=0m
JWT_REFRESH_EXPIRES_IN=0d

REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=
REDIS_DB=

SWAGGER_ENABLED=

THROTTLE_TTL=
THROTTLE_LIMIT=

# AI — local: ollama | prod: anthropic | optional: cursor
# Must match AiModule: unset non-prod defaults to ollama; production → anthropic
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
# OLLAMA_TIMEOUT_MS=120000
# Nest in Docker + Ollama on host: http://host.docker.internal:11434 (not 127.0.0.1)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
# Optional Cursor (AI_PROVIDER=cursor)
CURSOR_API_KEY=
CURSOR_MODEL=composer-2.5

# Brand Discovery — Bright Data Search + LLM scoring
BRAND_DISCOVERY_LIMIT=20
# llm (default) | templates — force buildBrandDiscoveryQueries()
# BRAND_SEARCH_STRATEGY=llm
BRIGHTDATA_API_KEY=

# Lead Discovery / BBC — Bright Data only (no Tavily)
BRIGHTDATA_DATASET_ID=
# Zones MUST be separate (SERP ≠ Unlocker). Do not share one zone for both.
# BRIGHTDATA_SERP_ZONE=
# BRIGHTDATA_UNLOCKER_ZONE=mcp_unlocker
# BRIGHTDATA_ZONE=   # legacy alias for Unlocker only if UNLOCKER_ZONE unset
# BRIGHTDATA_SEARCH_TIMEOUT_MS=30000
# BRIGHTDATA_SEARCH_MAX_RETRIES=2
# BRIGHTDATA_SEARCH_RETRY_BACKOFF_MS=1500
# BRIGHTDATA_SCRAPER_POLL_TIMEOUT_MS=120000
# BRIGHTDATA_SCRAPER_POLL_INTERVAL_MS=3000
# MAX_EMAIL_DISCOVERY_PAGES=6
# MAX_EMAIL_CANDIDATES=20
# MAX_BRAND_BUSINESS_CONTACT_PAGES=12
# MAX_BRAND_BUSINESS_CONTACTS=15
# LEAD_DISCOVERY_MAX_SEARCH_REQUESTS=30
LEAD_DISCOVERY_LIMIT=10
# APOLLO_API_KEY=

# AI-orchestrated contact research (demo caps)
# CONTACT_DISCOVERY_AI_ORCHESTRATOR=true
# AI_RESEARCH_MAX_SERP_QUERIES=5
# AI_RESEARCH_MAX_PAGES=5
# AI_RESEARCH_MAX_ITERATIONS=12

# ADMIN Unlocker diagnostic probe (Settings). Never enable in production.
# UNLOCKER_DIAGNOSTICS_ENABLED=false

# Phase 1 / BBC write path: rebuild on → POST /search enqueues contact-discovery.
# Local only — do not set true in production without explicit approval.
# CONTACT_DISCOVERY_REBUILD_MODE=false

