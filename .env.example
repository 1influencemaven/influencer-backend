PORT=

FRONTEND_URL=

DATABASE_URL=

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=0m
JWT_REFRESH_EXPIRES_IN=0d

REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=
REDIS_DB=

SWAGGER_ENABLED=

THROTTLE_TTL=
THROTTLE_LIMIT=

# AI — local: ollama | prod: anthropic | optional: cursor
# Must match AiModule: unset non-prod defaults to ollama; production → anthropic
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
# OLLAMA_TIMEOUT_MS=120000
# Nest in Docker + Ollama on host: http://host.docker.internal:11434 (not 127.0.0.1)
ANTHROPIC_API_KEY=
# Production (teliot.site) runs claude-haiku-5-5 (cheap, fast, native structured output).
ANTHROPIC_MODEL=claude-haiku-5-5
# Optional Cursor (AI_PROVIDER=cursor)
CURSOR_API_KEY=
CURSOR_MODEL=composer-2.5

# AI-003.3 — IBP always via BullMQ ↔ packages/influencer-ai (Mastra). No Nest AiService fallback.
# Requires Redis + running worker: npm run start:influencer-ai

# Brand Discovery — Bright Data Search + LLM scoring
BRAND_DISCOVERY_LIMIT=20
# llm (default) | templates — force buildBrandDiscoveryQueries()
# BRAND_SEARCH_STRATEGY=llm
# legacy (default) | mastra — Brand Discovery LLM engine
# BRAND_DISCOVERY_ENGINE=legacy
# P1b geographic SERP lenses: legacy (default, single gl/hl) | v1 (multi-lens under budget)
# BRAND_DISCOVERY_GEO_LENSES=legacy
# Max Bright Data SERP calls per Brand Discovery run when GEO_LENSES=v1 (default 12)
# BRAND_DISCOVERY_MAX_SERP_CALLS=12
# Countries (names or gl codes) that expand IBP market "LATAM". Empty = no expansion (do not invent MX).
# Examples: Mexico,Colombia,Argentina  or  mx,co,ar
# BRAND_DISCOVERY_REGION_LATAM_COUNTRIES=
# Optional Europe expansion (same format). Empty = no Europe→single-country proxy.
# BRAND_DISCOVERY_REGION_EUROPE_COUNTRIES=
# PLAN_SEARCH wait / worker deadline (raise on CPU-only Ollama hosts; prod: 300000)
# BRAND_DISCOVERY_PLAN_TIMEOUT_MS=120000
# Creator-program footprint SERP calls (plan_v3 2A) and known-brand seeds from the shared base
# BRAND_DISCOVERY_PROGRAM_QUERIES=2
# BRAND_DISCOVERY_KNOWN_BRANDS=5
# Deep research (mastra RESEARCH_BRAND) after SCORE (prod: 5)
# BRAND_DISCOVERY_RESEARCH_CONCURRENCY=4
# BRAND_DISCOVERY_RESEARCH_TIMEOUT_MS=300000
BRIGHTDATA_API_KEY=

# Contact / Lead — Bright Data zones (SERP ≠ Unlocker; do not share)
# BRIGHTDATA_SERP_ZONE=
# BRIGHTDATA_UNLOCKER_ZONE=mcp_unlocker
# Optional LinkedIn people dataset for Mastra 2B (default gd_l1viktl72bvl7bjuj0 in worker)
# BRIGHTDATA_LINKEDIN_PEOPLE_DATASET_ID=
# Talent Manager Instagram Profiles dataset (default gd_l1vikfch901nx3by4)
# BRIGHTDATA_INSTAGRAM_PROFILE_DATASET_ID=gd_l1vikfch901nx3by4
# DEPRECATED Unlocker alias if UNLOCKER_ZONE unset — do not use in new configs.
# BRIGHTDATA_ZONE=
# BRIGHTDATA_SEARCH_TIMEOUT_MS=60000
# BRIGHTDATA_SEARCH_MAX_RETRIES=2
# BRIGHTDATA_SEARCH_RETRY_BACKOFF_MS=1500
# BRIGHTDATA_SCRAPER_POLL_TIMEOUT_MS=300000
# BRIGHTDATA_SCRAPER_POLL_INTERVAL_MS=3000
# MAX_BRAND_BUSINESS_CONTACT_PAGES=12
# MAX_BRAND_BUSINESS_CONTACTS=15
LEAD_DISCOVERY_LIMIT=10
# APOLLO_API_KEY=

# influencer-ai worker: parallel AI jobs (keep 1-2 on CPU-only Ollama)
# AI_WORKER_CONCURRENCY=8

# Caps forwarded to Mastra FIND_BRAND_EMAILS (2A)
# AI_RESEARCH_MAX_SERP_QUERIES=5
# AI_RESEARCH_MAX_PAGES=5

# Caps forwarded to Mastra FIND_BRAND_PEOPLE (2B)
# AI_PEOPLE_MAX_SERP_QUERIES=4
# AI_PEOPLE_MAX_PROFILES=5
# AI_PEOPLE_MAX_BRAND_PAGES=6
# CONTACT_OCR_ENABLED=false

# ADMIN Unlocker diagnostic probe (Settings). Never enable in production.
# UNLOCKER_DIAGNOSTICS_ENABLED=false

# Saleshandy (Email Accounts module + contact enrichment). Never expose to the frontend.
# Lead Finder search is free; revealing emails spends credits.
SALESHANDY_API_KEY=
# SALESHANDY_BASE_URL=https://open-api.saleshandy.com/v1
SALESHANDY_TIMEOUT_MS=60000
SALESHANDY_ENRICHMENT_ENABLED=false
SALESHANDY_MAX_ENRICH_PER_BRAND=2
SALESHANDY_MIN_CREDITS=20
# SALESHANDY_ENRICH_TIMEOUT_MS=150000
